{
  "name": "learnito-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "schema:extract": "sanity schemas extract --path schema.json",
    "schema:deploy": "sanity schemas deploy",
    "typegen": "npm run schema:extract && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/vision": "^5.31.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
